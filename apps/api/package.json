{
  "name": "@root/api",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"--conditions=development\" hot-runner --node-args=\"--import=tsx\" ./src/server.ts",
    "start": "cross-env NODE_ENV=production node --enable-source-maps ./dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "format": "biome check --write .",
    "lint": "biome check .",
    "format:check": "biome check .",
    "db:migration": "kysely migrate make",
    "db:migrate": "kysely migrate latest",
    "db:rollback": "kysely migrate down",
    "db:generate": "kysely-codegen --dialect postgres --url \"postgresql://library:library@localhost:5432/library\" --out-file ./src/types/db.ts",
    "db:seed": "tsx --conditions=development ./src/database/seeds/__seed__.ts",
    "db:sync": "pnpm db:migrate && pnpm db:generate && pnpm db:seed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "imports": {
    "#config/*": {
      "development": "./src/config/*.js",
      "default": "./dist/config/*.js"
    },
    "#router/*": {
      "development": "./src/router/*.js",
      "default": "./dist/router/*.js"
    },
    "#controllers/*": {
      "development": "./src/controllers/*.js",
      "default": "./dist/controllers/*.js"
    },
    "#actions/*": {
      "development": "./src/actions/*.js",
      "default": "./dist/actions/*.js"
    },
    "#models/*": {
      "development": "./src/models/*.js",
      "default": "./dist/models/*.js"
    },
    "#types/*": {
      "development": "./src/types/*.js",
      "default": "./dist/types/*.js"
    },
    "#repositories/*": {
      "development": "./src/repositories/*.js",
      "default": "./dist/repositories/*.js"
    },
    "#enums/*": {
      "development": "./src/enums/*.js",
      "default": "./dist/enums/*.js"
    },
    "#validators/*": {
      "development": "./src/validators/*.js",
      "default": "./dist/validators/*.js"
    },
    "#helpers/*": {
      "development": "./src/helpers/*.js",
      "default": "./dist/helpers/*.js"
    },
    "#middlewares/*": {
      "development": "./src/middlewares/*.js",
      "default": "./dist/middlewares/*.js"
    },
    "#database/factories/*": {
      "development": "./src/database/factories/*.js",
      "default": "./dist/database/factories/*.js"
    }
  },
  "hotHook": {
    "boundaries": [
      "./actions/**/*.ts",
      "./router/**/*.ts"
    ],
    "restart": [
      "../../.env",
      "./config/**/*.ts"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.1135.0",
    "@vinejs/vine": "^4.4.0",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "flydrive": "^2.1.0",
    "kysely": "^0.29.5",
    "multer": "^2.3.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@hot-hook/runner": "^1.0.0",
    "@root/biome-config": "workspace:*",
    "@root/tsconfig": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "hot-hook": "^1.0.0",
    "kysely-codegen": "^0.20.0",
    "kysely-ctl": "^0.21.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
