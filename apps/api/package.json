{
  "name": "@root/api",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "hot-runner --node-args=\"--import=tsx\" ./src/server.ts",
    "start": "NODE_ENV=production node --import=tsx ./src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "format": "biome check --write .",
    "lint": "biome check .",
    "format:check": "biome check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "imports": {
    "#config/*": "./src/config/*.js",
    "#router/*": "./src/router/*.js",
    "#controllers/*": "./src/controllers/*.js",
    "#actions/*": "./src/actions/*.js"
  },
  "hotHook": {
    "boundaries": [
      "./actions/**/*.ts",
      "./router/**/*.ts"
    ],
    "restart": [
      ".env",
      "./config/**/*.ts"
    ]
  },
  "dependencies": {
    "express": "^5.2.1",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@hot-hook/runner": "^1.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "hot-hook": "^1.0.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "@root/biome-config": "workspace:*",
    "@root/tsconfig": "workspace:*"
  }
}
