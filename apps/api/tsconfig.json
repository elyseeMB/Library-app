{
  "extends": "@root/tsconfig/base.json",
  "compilerOptions": {
    "experimentalDecorators": true,
    "types": ["hot-hook/import-meta"],
    "customConditions": ["development"],
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true
  }
}
